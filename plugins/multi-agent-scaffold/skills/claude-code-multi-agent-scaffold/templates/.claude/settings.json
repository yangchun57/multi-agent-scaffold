{
  "permissions": {
    "allow": ["Read", "Glob", "Grep", "Write", "Edit", "WebFetch", "WebSearch"],
    "deny": [
      "Bash(rm:*)", "Bash(rm -rf:*)", "Bash(git push:*)",
      "Bash(git reset --hard:*)", "Bash(git clean -fd:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_commit_guard.py\"" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit", "hooks": [ { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/tenant_guard.py\"" } ] }
    ]
  }
}
